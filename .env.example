# Server-only. Access token for the Surfr. leaderboard consumed by
# /api/getRanking. Never prefix it with NEXT_PUBLIC_: that would ship it to the
# browser. Without it the kitesurf ranking falls back to src/data/leaderboard.ts.
SURFR_ACCESS_TOKEN=

# Formspark form id the contact form posts to (https://submit-form.com/<id>).
NEXT_PUBLIC_FORMSPARK_ID=

# Google Analytics measurement id (G-XXXXXXX). Only loaded once the visitor
# accepts analytics cookies.
NEXT_PUBLIC_ANALYTICS_ID=
